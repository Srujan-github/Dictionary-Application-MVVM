<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    • Release: HTTPS-only for all domains. Cleartext HTTP is explicitly denied.
    • Debug: Localhost cleartext allowed for local mock servers and Charles/Proxy.

    API docs: https://developer.android.com/training/articles/security-config
-->
<network-security-config>

    <!-- Production: enforce HTTPS everywhere -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only the system CA store in production -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug override: allow cleartext to localhost for local dev servers -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
