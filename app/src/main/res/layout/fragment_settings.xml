<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xxl"
        tools:context=".ui.fragments.SettingsFragment">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/settings"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/txtSize_28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/settings_subtitle"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/txtSize_14sp" />

        <!-- PREFERENCES section label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/pref_section"
            style="@style/TextAppearance.Lexicon.SectionLabel" />

        <!-- Preferences card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/screen_margin"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/corner_card_md"
            app:cardElevation="@dimen/elevation_card"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Dark Mode row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dark_mode"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/txtSize_16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/dark_mode_subtitle"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="@dimen/txtSize_12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider" />

                <!-- Daily Word row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/daily_word"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/txtSize_16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/daily_word_subtitle"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="@dimen/txtSize_12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDailyWord"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_divider" />

                <!-- Language row -->
                <LinearLayout
                    android:id="@+id/rowLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/language"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/txtSize_16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLanguageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/language_value"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/txtSize_14sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ABOUT section label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/about_section"
            style="@style/TextAppearance.Lexicon.SectionLabel" />

        <!-- About card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/screen_margin"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/corner_card_md"
            app:cardElevation="@dimen/elevation_card"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rowAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/space_md"
                    android:text="@string/about_lexicon"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/txtSize_16sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/color_divider" />

                <TextView
                    android:id="@+id/rowPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/space_md"
                    android:text="@string/privacy_policy"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/txtSize_16sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/color_divider" />

                <TextView
                    android:id="@+id/rowFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/space_md"
                    android:text="@string/send_feedback"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/txtSize_16sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/color_divider" />

                <TextView
                    android:id="@+id/rowRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/space_md"
                    android:text="@string/rate_app"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/txtSize_16sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Version -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginStart="@dimen/screen_margin"
            android:textColor="@color/color_text_hint"
            android:textSize="@dimen/txtSize_12sp"
            tools:text="Lexicon v1.0.0" />

    </LinearLayout>
</ScrollView>
