<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp"
        tools:context=".ui.fragments.MainFragment">

        <!-- ── Header ── -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/discover_words"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/txtSize_28sp"
            android:textStyle="bold" />

        <labs.creative.dictornarymvvm.ui.widgets.TypeWriterView
            android:id="@+id/tagTypeWriter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/txtSize_14sp" />

        <!-- ── Search Bar (navigation trigger + shared element) ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSearchBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_bar_height"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginEnd="@dimen/screen_margin"
            android:transitionName="shared_search_bar"
            app:cardBackgroundColor="@color/color_surface_variant"
            app:cardCornerRadius="@dimen/corner_pill"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md">

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:contentDescription="@string/search_icon"
                    android:src="@drawable/ic_search"
                    app:tint="@color/color_text_hint" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="@string/search_hint"
                    android:textColor="@color/color_text_hint"
                    android:textSize="@dimen/txtSize_16sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Recent Section ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_history"
                app:tint="@color/color_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/section_recent"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/txtSize_18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llRecentChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin" />
        </HorizontalScrollView>

        <!-- ── Word of the Day Card ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="@dimen/space_xs"
                android:text="@string/section_word_of_the_day"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/txtSize_18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWotd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/screen_margin"
            app:cardBackgroundColor="@color/color_primary_container"
            app:cardCornerRadius="@dimen/corner_card_lg"
            app:cardElevation="@dimen/elevation_card"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_md">

                <TextView
                    android:id="@+id/tvWotdWord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/txtSize_22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/btnWotdArrow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Ephemeral" />

                <TextView
                    android:id="@+id/tvWotdPhonetic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/txtSize_14sp"
                    app:layout_constraintEnd_toStartOf="@+id/btnWotdArrow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvWotdWord"
                    tools:text="/ih-FEM-er-uhl/" />

                <TextView
                    android:id="@+id/tvWotdDefinition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/txtSize_14sp"
                    app:layout_constraintEnd_toStartOf="@+id/btnWotdArrow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvWotdPhonetic"
                    tools:text="Lasting for a very short time. Something that is fleeting, transitory." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWotdArrow"
                    style="@style/Widget.Material3.Button.Icon"
                    android:layout_width="@dimen/fab_size"
                    android:layout_height="@dimen/fab_size"
                    android:contentDescription="@string/section_word_of_the_day"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="@dimen/corner_fab"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textStart"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Trending Section ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_trending_up"
                app:tint="@color/color_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/section_trending"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/txtSize_18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvTrending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/screen_margin"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_trending_word" />

    </LinearLayout>
</ScrollView>